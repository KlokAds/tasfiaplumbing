<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # One address for the site: https and without "www."
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !(^localhost|^127\.0\.0\.1|\.test$) [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Uploaded photos are data, never code: refuse scripts inside upload and cache folders
    RewriteRule ^(Admin|Images|Service\ Image|uploads|cache)/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|shtml|htaccess)$ - [F,NC,L]

    # Hidden files (.env, .git, .htaccess ...) are never served; .well-known stays open for SSL checks
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Browser and CDN caching
<IfModule mod_headers.c>
    # Built CSS/JS/fonts carry a content hash in their name, so they can be kept for a year.
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Photos and icons: a month.
    <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico|avif)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
